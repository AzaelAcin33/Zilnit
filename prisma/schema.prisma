// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  username String @unique
  email String @unique
  avatarUrl String?
  countryCode String?
  language String?
  level Int @default(1)
  experience Int @default(0)
  referralCode String? @unique
  referredBy String?
  isBlocked Boolean @default(false)
  trustScore Float @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices UserDevice[]
  wallet Wallet?
  rewardCompletions RewardCompletion[]
  favorites Favorite[]
  interactions UserInteraction[]
  orders Order[]
  affiliateClicks AffiliateClick[]
  adImpressions AdImpression[]
  sentReferrals Referral[] @relation("UserInviter")
  receivedReferrals Referral[] @relation("UserInvited")
  notifications Notification[]
  events Event[]
  fraudScores FraudScore[]
  addresses Address[]
}

model UserDevice {
  id String @id @default(uuid())
  userId String
  deviceFingerprint String
  ipHash String?
  platform String
  appVersion String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Category {
  id String @id @default(uuid())
  name String @unique
  slug String @unique
  icon String?
  color String?
  description String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
}

model Product {
  id String @id @default(uuid())
  platformSource String
  externalProductId String
  title String
  slug String @unique
  description String?
  price Decimal @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  currency String
  shippingCost Decimal? @db.Decimal(10, 2)
  affiliateUrl String?
  purchaseUrl String?
  brand String?
  rating Float?
  reviewCount Int?
  stock Int?
  isAffiliate Boolean @default(true)
  directSale Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id])
  media ProductMedia[]
  priceHistory ProductPriceHistory[]
  @@index([platformSource])
  @@index([externalProductId])
  @@index([categoryId])
  favorites Favorite[]
  feedPosts FeedPost[]
  orderItems OrderItem[]
  affiliateClicks AffiliateClick[]
}

model ProductMedia {
  id String @id @default(uuid())
  productId String
  type String //image|video
  url String
  position Int @default(0)
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id])
  @@index([productId])
}

model ProductPriceHistory {
  id String @id @default(uuid())
  productId String
  oldPrice Decimal @db.Decimal(10, 2)
  newPrice Decimal @db.Decimal(10, 2)
  changedAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id])
  @@index([productId])
}

model Wallet {
  id String @id @default(uuid())
  userId String @unique
  coinsBalance Int @default(0)
  gemsBalance Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id String @id @default(uuid())
  walletId String
  type String
  amount Int
  description String?
  referenceId String?
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  @@index([walletId])
}

model RewardTask {
  id String @id @default(uuid())
  name String
  description String?
  reward Int
  conditions String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completions RewardCompletion[]
}

model RewardCompletion {
  id String @id @default(uuid())
  userId String
  taskId String
  completedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task RewardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([taskId])
  @@unique([userId, taskId])
}

model Favorite {
  id String @id @default(uuid())
  userId String
  productId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model FeedPost {
  id String @id @default(uuid())
  productId String?
  description String?
  videoUrl String?
  likesCount Int @default(0)
  commentsCount Int @default(0)
  sharesCount Int @default(0)
  viewsCount Int @default(0)
  score Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product? @relation(fields: [productId], references: [id])
  interactions UserInteraction[]
  @@index([productId])
}

model UserInteraction {
  id String @id @default(uuid())
  userId String
  feedPostId String?
  interactionType String
  viewTimeMs Int?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedPost FeedPost? @relation(fields: [feedPostId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([feedPostId])
}

model Order {
  id String @id @default(uuid())
  userId String
  totalAmount Decimal @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  status String @default("PENDING")
  paymentStatus String @default("PENDING")
  provider String?
  trackingNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
  @@index([userId])
}

model OrderItem {
  id String @id @default(uuid())
  orderId String
  productId String
  quantity Int @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([orderId])
  @@index([productId])
}

model AffiliateClick {
  id String @id @default(uuid())
  userId String?
  productId String
  affiliateNetwork String
  converted Boolean @default(false)
  commissionAmount Decimal? @db.Decimal(10, 2)
  clickedAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([productId])
}

model AdImpression {
  id String @id @default(uuid())
  userId String?
  network String
  placement String
  revenue Decimal? @db.Decimal(10, 4)
  watchedSeconds Int?
  rewarded Boolean @default(false)
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Referral {
  id String @id @default(uuid())
  inviterId String
  invitedUserId String
  rewarded Boolean @default(false)
  createdAt DateTime @default(now())
  inviter User @relation("UserInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitedUser User @relation("UserInvited", fields: [invitedUserId], references: [id], onDelete: Cascade)
  @@unique([inviterId, invitedUserId])
  @@index([inviterId])
  @@index([invitedUserId])
}

model Notification {
  id String @id @default(uuid())
  userId String
  title String
  message String
  type String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Event {
  id String @id @default(uuid())
  userId String?
  eventType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([eventType])
}

model FraudScore {
  id String @id @default(uuid())
  userId String
  score Int @default(0)
  reason String?
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Address {
  id String @id @default(uuid())
  userId String
  fullName String
  phone String?
  country String
  city String
  postalCode String
  address1 String
  address2 String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}